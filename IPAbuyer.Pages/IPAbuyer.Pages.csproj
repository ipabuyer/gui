<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <DefaultLanguage>zh-Hans</DefaultLanguage>
        <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
        <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
        <UseWinUI>true</UseWinUI>
        <WinUISDKReferences>false</WinUISDKReferences>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>IPAbuyer.Pages</RootNamespace>
        <Platforms>x64;ARM64</Platforms>
    </PropertyGroup>

    <ItemGroup>
        <PRIResource Include="..\Strings\en-US\Resources.resw" Link="Strings\en-US\Resources.resw" />
        <PRIResource Include="..\Strings\zh-Hans\Resources.resw" Link="Strings\zh-Hans\Resources.resw" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
        <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
        <ProjectReference Include="..\IPAbuyer.Core\IPAbuyer.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Page Update="**\*.xaml">
            <Generator>MSBuild:Compile</Generator>
        </Page>
    </ItemGroup>
</Project>
